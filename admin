async function api(method, path, body){
  const t0 = performance.now();
  await sleep(rnd(70,220));
  let status = 200, data, ctx = {};
  try {
    const route = routes.find(r => r.m === method && r.r.test(path));
    if (!route) throw new HttpError(404, 'No route matched ' + method + ' ' + path);
    const m = path.match(route.r) || [];
    const params = m.slice(1).map(decodeURIComponent);
    if (!route.pub) {
      const userId = AUTH_TOKEN ? db.sessions[AUTH_TOKEN] : null;
      const user = db.users.find(u => u.id === userId);
      if (!user) throw new HttpError(401, 'Session expired — please sign in again');
      ctx.user = user;
      if (route.admin && user.role !== 'admin') throw new HttpError(403, 'Admin access required');
    }
    data = await route.h(params, body || {}, ctx);
  } catch (e) {
    status = e.status || 500;
    data = { error: e.message || 'Something went wrong' };
  }
  requestLog.unshift({ method, path, status, ms: Math.round(performance.now()-t0), at: new Date().toLocaleTimeString() });
  if (requestLog.length > 60) requestLog.length = 60;
  return { status, data };
}

