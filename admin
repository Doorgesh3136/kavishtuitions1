/* ---------- toast ---------- */
function toast(msg, kind){
  const wrap = document.getElementById('toasts');
  if (!wrap) return;
  const el = document.createElement('div');
  el.className = 'toast ' + (kind || '');
  el.textContent = msg;
  wrap.appendChild(el);
  setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(() => el.remove(), 320); }, 2600);
}

/* ---------- auth ---------- */
async function boot(){
  AUTH_TOKEN = ls.get(TOKEN_KEY) || null;
  if (AUTH_TOKEN) {
    const r = await api('GET','/auth/me');
    if (r.status === 200) state.user = r.data;
    else { AUTH_TOKEN = null; ls.del(TOKEN_KEY); }
  }
  render();
}

async function doLogin(email, password){
  const r = await api('POST','/auth/login', { email, password });
  if (r.status !== 200) return { ok:false, error:r.data.error };
  AUTH_TOKEN = r.data.token;
  ls.set(TOKEN_KEY, AUTH_TOKEN);
  state.user = r.data.user;
  await go('dashboard');
  toast('Welcome, ' + state.user.name.split(' ')[0], 'ok');
  return { ok:true };
}

async function doSignup(name, email, password){
  const r = await api('POST','/auth/signup', { name, email, password });
  if (r.status !== 200) return { ok:false, error:r.data.error };
  AUTH_TOKEN = r.data.token;
  ls.set(TOKEN_KEY, AUTH_TOKEN);
  state.user = r.data.user;
  await go('dashboard');
  toast(r.data.whitelisted ? 'Account created as ' + state.user.role : 'Account created', 'ok');
  return { ok:true };
}

async function doLogout(){
  await api('POST','/auth/logout');
  AUTH_TOKEN = null;
  ls.del(TOKEN_KEY);
  state.user = null;
  state.view = 'dashboard';
  state.content = []; state.orders = []; state.users = [];
  state.whitelist = []; state.announcements = []; state.progress = {};
  state.stats = null; state.filter = { type:'all', q:'' }; state.selected.clear();
  state.modal = null; state.lastResponse = null; state.authMode = 'login';
  render();
  toast('Signed out');
}

function resetDatabase(){
  ls.del(DB_KEY); ls.del(TOKEN_KEY);
  db = loadDB();
  AUTH_TOKEN = null;
  state.user = null; state.view = 'dashboard';
  state.content = []; state.orders = []; state.users = [];
  state.whitelist = []; state.announcements = []; state.progress = {};
  state.stats = null; state.filter = { type:'all', q:'' }; state.selected.clear();
  state.modal = null; state.lastResponse = null; state.authMode = 'login';
  requestLog.length = 0;
  render();
  toast('Demo data reset', 'ok');
}

/* ---------- navigation ---------- */
async function go(view){
  if (view === 'users' && state.user.role !== 'admin') view = 'dashboard';
  state.view = view;
  state.modal = null;
  state.selected.clear();
  render();
  try { await loadData(view); } catch(e){ console.error(e); }
  render();
}

async function loadData(view){
  if (view === 'dashboard') {
    const rs = await Promise.all([
      api('GET','/content'), api('GET','/orders'),
      api('GET','/announcements'), api('GET','/progress')
    ]);
    if (rs[0].status === 200) state.content = rs[0].data;
    if (rs[1].status === 200) state.orders = rs[1].data;
    if (rs[2].status === 200) state.announcements = rs[2].data;
    if (rs[3].status === 200) state.progress = rs[3].data;
    if (state.user.role === 'admin') {
      const sr = await api('GET','/stats');
      if (sr.status === 200) state.stats = sr.data;
    }
  }
  if (view === 'library') {
    const r = await api('GET','/content');
    if (r.status === 200) state.content = r.data;
    if (state.user.role !== 'admin') {
      const pr = await api('GET','/progress');
      if (pr.status === 200) state.progress = pr.data;
    }
  }
  if (view === 'orders') {
    const r = await api('GET','/orders');
    if (r.status === 200) state.orders = r.data;
  }
  if (view === 'users' && state.user.role === 'admin') {
    const rs = await Promise.all([api('GET','/users'), api('GET','/whitelist')]);
    if (rs[0].status === 200) state.users = rs[0].data;
    if (rs[1].status === 200) state.whitelist = rs[1].data;
  }
}

