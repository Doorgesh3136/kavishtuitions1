function loadDB(){
  try {
    const raw = ls.get(DB_KEY);
    if (raw) {
      const p = JSON.parse(raw);
      const valid = p && Array.isArray(p.users) && p.users.length > 0 &&
        Array.isArray(p.content) && Array.isArray(p.orders) &&
        p.sessions && typeof p.sessions === 'object' &&
        p.users.every(u => u && u.id && u.email && u.password && u.role);
      if (valid) {
        if (!Array.isArray(p.whitelist)) p.whitelist = [];
        if (!Array.isArray(p.announcements)) p.announcements = [];
        if (!p.progress || typeof p.progress !== 'object') p.progress = {};
        return p;
      }
    }
  } catch(e){}
  const fresh = seedDB();
  ls.set(DB_KEY, JSON.stringify(fresh));
  return fresh;
}
let db = loadDB();
