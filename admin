  else { toast(r.data.error || 'Failed', 'bad'); await loadData('users'); render(); }
});

document.addEventListener('submit', async e => {
  e.preventDefault();
  const form = e.target;
  if (!form) return;

  if (form.id === 'content-form') {
    const id = form.getAttribute('data-id');
    const payload = {
      title: form.elements['title'].value.trim(),
      type: form.elements['type'].value,
      subject: form.elements['subject'].value.trim() || 'General',
      price: Number(form.elements['price'].value) || 0,
      url: form.elements['url'].value.trim(),
      description: form.elements['description'].value.trim(),
      published: form.elements['published'].checked
    };
    const res = id ? await api('PATCH','/content/'+id, payload) : await api('POST','/content', payload);
    if (res.status >= 400) { toast(res.data.error || 'Save failed', 'bad'); return; }
    state.modal = null;
    toast(id ? 'Content updated' : 'Content created', 'ok');
    await loadData(state.view); render();
    return;
  }

  if (form.id === 'password-form') {
    const oldPassword = form.elements['oldPassword'].value;
    const newPassword = form.elements['newPassword'].value;
    const confirmPassword = form.elements['confirmPassword'].value;
    if (newPassword !== confirmPassword) { toast('Passwords do not match', 'bad'); return; }
    const r = await api('POST','/auth/password', { oldPassword, newPassword });
    if (r.status === 200) { toast('Password updated', 'ok'); form.reset(); }
    else toast(r.data.error || 'Failed', 'bad');
    return;
  }

  if (form.id === 'whitelist-form') {
    const email = form.elements['email'].value.trim();
    const role = form.elements['role'].value;
    const note = form.elements['note'].value.trim();
    const r = await api('POST','/whitelist', { email, role, note });
    if (r.status === 200) { toast('Added to whitelist', 'ok'); form.reset(); await loadData('users'); render(); }
    else toast(r.data.error || 'Failed', 'bad');
    return;
  }

  if (form.id === 'ann-form') {
    const title = form.elements['title'].value.trim();
    const body = form.elements['body'].value.trim();
    const r = await api('POST','/announcements', { title, body });
    if (r.status === 200) {
      state.modal = null;
      toast('Announcement published', 'ok');
      await loadData(state.view); render();
    } else toast(r.data.error || 'Failed', 'bad');
    return;
  }
});

document.addEventListener('input', e => {
  if (e.target.id !== 'search') return;
  state.filter.q = e.target.value;
  const results = document.getElementById('library-results');
  if (!results) return;
  results.innerHTML = resultsHTML(filterItems(state.filter.type, state.filter.q));
});

document.addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    if (e.target.id === 'login-email' || e.target.id === 'login-pw') { e.preventDefault(); handleLogin(); return; }
    if (e.target.id === 'su-name' || e.target.id === 'su-email' || e.target.id === 'su-pw') { e.preventDefault(); handleSignup(); return; }
  }
  if (e.key === 'Escape' && state.modal) { state.modal = null; render(); }
});

/* ---------- auth handlers ---------- */
async function handleLogin(){
  const emailEl = document.getElementById('login-email');
  const pwEl = document.getElementById('login-pw');
  const errEl = document.getElementById('auth-err');
  const btn = document.getElementById('login-btn');
  if (!emailEl || !pwEl || !btn) return;
  const email = emailEl.value.trim();
  const password = pwEl.value;
  if (!email) { showAuthErr('Please enter your email'); return; }
  if (!password) { showAuthErr('Please enter your password'); return; }
  if (errEl) { errEl.textContent = ''; errEl.classList.remove('show'); }
  btn.disabled = true; const old = btn.textContent; btn.textContent = 'Signing in…';
  try {
    const result = await doLogin(email, password);
    if (!result.ok) { showAuthErr(result.error || 'Login failed'); btn.disabled = false; btn.textContent = old; }
  } catch(err) {
    console.error(err);
    showAuthErr('Unexpected: ' + (err.message || err));
    btn.disabled = false; btn.textContent = old;
  }
}

async function handleSignup(){
  const nameEl = document.getElementById('su-name');
  const emailEl = document.getElementById('su-email');
  const pwEl = document.getElementById('su-pw');
  const errEl = document.getElementById('auth-err');
  const btn = document.getElementById('signup-btn');
  if (!nameEl || !emailEl || !pwEl || !btn) return;
  const name = nameEl.value.trim();
  const email = emailEl.value.trim();
  const password = pwEl.value;
  if (!name) { showAuthErr('Name is required'); return; }
  if (!email) { showAuthErr('Email is required'); return; }
  if (password.length < 6) { showAuthErr('Password must be at least 6 characters'); return; }
  if (errEl) { errEl.textContent = ''; errEl.classList.remove('show'); }
  btn.disabled = true; const old = btn.textContent; btn.textContent = 'Creating…';
  try {
    const result = await doSignup(name, email, password);
    if (!result.ok) { showAuthErr(result.error || 'Signup failed'); btn.disabled = false; btn.textContent = old; }
  } catch(err) {
    console.error(err);
    showAuthErr('Unexpected: ' + (err.message || err));
    btn.disabled = false; btn.textContent = old;
  }
}

function showAuthErr(msg){
  const el = document.getElementById('auth-err');
  if (!el) { toast(msg, 'bad'); return; }
  el.textContent = msg; el.classList.add('show');
}

boot();
})();
</script>
</body>
</html>
