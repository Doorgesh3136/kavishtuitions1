
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080d1a">
<title>Studia — Mauritius study centre</title>
<style>
  :root{
    --bg:#080d1a; --panel:#111a2e; --panel2:#16223c; --line:#233152;
    --text:#e8eeff; --muted:#8794b8; --accent:#5b8cff; --accent2:#22c9a0;
    --gold:#f5a524; --gold2:#e8853c; --purple:#8b5bff;
    --warn:#f5a524; --danger:#ef4b6b; --radius:14px;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;min-width:0}
  html{-webkit-text-size-adjust:100%;-webkit-tap-highlight-color:transparent}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,sans-serif;
    background:radial-gradient(1100px 550px at 8% -10%, #17224a 0%, transparent 60%), var(--bg);
    color:var(--text); min-height:100vh; min-height:100svh;
    -webkit-font-smoothing:antialiased;
    overflow-y:auto;
  }
  button,input,select,textarea{font:inherit;color:inherit}
  button,.nav-item,.chip,.card,.mobile-tab{touch-action:manipulation;-webkit-tap-highlight-color:transparent;cursor:pointer}
  a{color:var(--accent);text-decoration:none}
  img,svg,video,canvas{max-width:100%;height:auto}

  /* ---------- auth ---------- */
  .login-wrap{min-height:100vh;min-height:100svh;display:flex;flex-direction:column;padding:24px}
  .login-card{
    width:100%;max-width:420px;margin:auto;
    background:linear-gradient(180deg,var(--panel),#0e1628);
    border:1px solid var(--line);border-radius:22px;padding:28px;
    box-shadow:0 30px 80px rgba(0,0,0,.55);
  }
  .brand{display:flex;gap:14px;align-items:center;margin-bottom:22px}
  .logo{
    width:44px;height:44px;border-radius:13px;display:grid;place-items:center;flex:none;
    background:linear-gradient(135deg,var(--accent),var(--purple));font-weight:800;font-size:19px;color:#fff;
  }
  .brand-text{min-width:0}
  .brand h1{font-size:18px;letter-spacing:-.3px}
  .brand p{font-size:12px;color:var(--muted)}
  .field{margin-bottom:14px}
  .field label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px;font-weight:600;letter-spacing:.3px}
  .field input,.field select,.field textarea{
    width:100%;background:#0b1324;border:1px solid var(--line);border-radius:10px;
    padding:12px 13px;font-size:16px;outline:none;transition:.15s;
  }
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(91,140,255,.15)}
  .btn{
    border:1px solid var(--line);background:var(--panel2);border-radius:10px;
    padding:10px 16px;font-size:13px;font-weight:600;cursor:pointer;transition:.15s;
    display:inline-flex;align-items:center;gap:7px;justify-content:center;
    min-height:38px;white-space:nowrap;
  }
  .btn:hover{background:#1d2a4c;border-color:#33436e}
  .btn:active{transform:scale(.97)}
  .btn:disabled{opacity:.6;cursor:wait;transform:none}
  .btn.primary{background:linear-gradient(135deg,var(--accent),#7a6bff);border-color:transparent;color:#fff}
  .btn.primary:hover{filter:brightness(1.12)}
  .btn.green{background:var(--accent2);border-color:transparent;color:#04241b}
  .btn.gold{background:linear-gradient(135deg,var(--gold),var(--gold2));border-color:transparent;color:#1a0e00;font-weight:700}
  .btn.gold:hover{filter:brightness(1.1)}
  .btn.danger{background:rgba(239,75,107,.14);border-color:rgba(239,75,107,.4);color:#ff8ca3}
  .btn.block{width:100%;padding:13px}
  .btn.sm{padding:6px 11px;font-size:12px;min-height:32px}
  .demo-creds{display:grid;gap:6px;margin-top:16px;padding-top:14px;border-top:1px dashed var(--line)}
  .demo-creds .row{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:12px;color:var(--muted)}
  .demo-creds .row span{font-weight:600;color:#a9b6d8}
  .err{background:rgba(239,75,107,.12);border:1px solid rgba(239,75,107,.35);color:#ff9db2;
       padding:10px 12px;border-radius:9px;font-size:12.5px;margin-bottom:14px;display:none;overflow-wrap:anywhere}
  .err.show{display:block}
  .auth-toggle{text-align:center;font-size:12.5px;color:var(--muted);margin-top:16px}
  .auth-toggle button{background:none;border:none;color:var(--accent);font-weight:600;padding:4px;font-size:12.5px}

  /* ---------- shell ---------- */
  .shell{display:grid;grid-template-columns:238px 1fr;min-height:100vh;min-height:100svh}
  .sidebar{
    background:linear-gradient(180deg,#0c1425,#0a1120);border-right:1px solid var(--line);
    padding:20px 14px;display:flex;flex-direction:column;gap:6px;
    position:sticky;top:0;height:100vh;height:100svh;
  }
  .sidebar .brand{margin-bottom:18px;padding:0 6px}
  .sidebar .brand h1{font-size:16px}
  .sidebar .brand p{font-size:11px}
  .nav{display:flex;flex-direction:column;gap:6px}
  .nav-item{
    display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;
    font-size:13.5px;color:var(--muted);border:1px solid transparent;transition:.15s;font-weight:500;
    min-height:40px;
  }
  .nav-item:hover{background:#141e35;color:var(--text)}
  .nav-item:active{transform:scale(.98)}
  .nav-item.active{background:rgba(91,140,255,.13);border-color:rgba(91,140,255,.3);color:#b9cdff;font-weight:600}
  .nav-item .ic{width:18px;text-align:center;opacity:.85;flex:none}
  .spacer{flex:1}
  .userbox{border-top:1px solid var(--line);padding-top:14px;font-size:12.5px}
  .userbox .name{font-weight:600;font-size:13px;overflow-wrap:anywhere}
  .userbox .mail{color:var(--muted);font-size:11.5px;margin-bottom:4px;word-break:break-all}
  .userbox .role-pill{display:inline-block;margin-bottom:10px}
  .userbox .btn{width:100%}
  .role-pill{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.6px;
    padding:2px 7px;border-radius:99px;text-transform:uppercase}
  .role-pill.admin  {background:rgba(139,91,255,.18);color:#b69cff}
  .role-pill.premium{background:rgba(245,165,36,.18);color:#f7bc5a}
  .role-pill.student{background:rgba(34,201,160,.16);color:#4fd8b3}

  .main{padding:26px 30px 60px}
  .topbar{margin-bottom:22px}
  .topbar h2{font-size:22px;letter-spacing:-.4px}
  .topbar p{font-size:13px;color:var(--muted);margin-top:4px}

  .mobile-tabs{display:none}

  /* ---------- cards / stats ---------- */
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:22px}
  .stat{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px}
  .stat .k{font-size:11.5px;color:var(--muted);letter-spacing:.4px;text-transform:uppercase;font-weight:600}
  .stat .v{font-size:26px;font-weight:700;margin-top:8px;letter-spacing:-.8px}
  .stat .v.accent{color:var(--accent)}
  .stat .v.green{color:var(--accent2)}
  .stat .v.gold{color:var(--gold)}

  .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
  .toolbar input[type=search]{
    flex:1;min-width:160px;background:#0b1324;border:1px solid var(--line);border-radius:10px;
    padding:11px 13px;font-size:16px;outline:none;
  }
  .toolbar input[type=search]:focus{border-color:var(--accent)}
  .chip{
    padding:8px 13px;border-radius:99px;border:1px solid var(--line);background:#0e1729;
    font-size:12.5px;color:var(--muted);transition:.15s;font-weight:500;white-space:nowrap;
    min-height:34px;
  }
  .chip:hover{color:var(--text)}
  .chip.on{background:rgba(91,140,255,.16);border-color:rgba(91,140,255,.45);color:#bcd0ff}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
  .card{
    background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
    padding:16px;display:flex;flex-direction:column;gap:10px;transition:.18s;
  }
  .card:hover{border-color:#33436e;transform:translateY(-2px);box-shadow:0 14px 34px rgba(0,0,0,.35)}
  .card .head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
  .card h4{font-size:14.5px;line-height:1.35;letter-spacing:-.2px;overflow-wrap:anywhere}
  .card .desc{font-size:12.5px;color:var(--muted);line-height:1.5;flex:1;overflow-wrap:anywhere}
  .card .foot{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:2px;flex-wrap:wrap}
  .badge{font-size:10.5px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;
    padding:3px 8px;border-radius:6px;white-space:nowrap;flex:none}
  .badge.video{background:rgba(239,75,107,.15);color:#ff8ca3}
  .badge.pdf{background:rgba(91,140,255,.15);color:#8fb2ff}
  .badge.notes{background:rgba(34,201,160,.15);color:#4fd8b3}
  .badge.live{background:rgba(245,165,36,.15);color:#f7bc5a}
  .badge.draft{background:rgba(135,148,184,.15);color:#9aa7c8}
  .badge.done{background:rgba(34,201,160,.18);color:#6fe4c0}
  .badge.premium-only{background:rgba(245,165,36,.18);color:#f7bc5a}
  .price{font-weight:700;font-size:15px;white-space:nowrap}
  .price.free{color:var(--accent2)}
  .meta{font-size:11.5px;color:#67739a;overflow-wrap:anywhere}

  .tbl-wrap{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
  .tbl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table{width:100%;border-collapse:collapse;font-size:13px}
  thead th{
    text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);
    padding:10px 12px;border-bottom:1px solid var(--line);font-weight:700;white-space:nowrap;
  }
  tbody td{padding:12px;border-bottom:1px solid #182238}
  tbody tr:hover{background:#0f1830}

  .console-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px}
  .panel h3{font-size:13px;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin-bottom:12px}
  pre{
    background:#070c17;border:1px solid var(--line);border-radius:10px;padding:14px;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.6;
    overflow:auto;max-height:340px;color:#a9c4ff;white-space:pre-wrap;word-break:break-word;
  }
  .log-row{
    display:flex;gap:10px;align-items:center;font-family:ui-monospace,Menlo,monospace;
    font-size:11.5px;padding:7px 9px;border-radius:7px;
  }
  .log-row:nth-child(odd){background:#0d1526}
  .log-row .st{font-weight:700;width:34px;flex:none}
  .st.ok{color:var(--accent2)} .st.warn{color:var(--warn)} .st.bad{color:var(--danger)}
  .log-row .m{color:#8fb2ff;width:56px;flex:none}
  .log-row .p{flex:1;color:#a9b6d8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .log-row .t{color:#5d688c;font-size:10.5px;white-space:nowrap}
  .presets{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}

  .overlay{
    position:fixed;inset:0;background:rgba(4,8,18,.86);
    display:flex;padding:16px;z-index:100;
    overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;
  }
  .modal{
    width:100%;max-width:560px;margin:auto;
    background:linear-gradient(180deg,var(--panel),#0d1526);
    border:1px solid var(--line);border-radius:18px;padding:22px;
    box-shadow:0 40px 90px rgba(0,0,0,.7);
  }
  .modal.wide{max-width:720px}
  .modal .mhead{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:16px}
  .modal .mhead h3{font-size:17px;letter-spacing:-.3px;line-height:1.35;overflow-wrap:anywhere}
  .close-x{background:none;border:none;color:var(--muted);font-size:26px;line-height:1;padding:0 4px;flex:none;min-width:36px;min-height:36px;display:grid;place-items:center}
  .close-x:hover{color:var(--text)}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .checkline{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin-bottom:12px}
  .checkline input{width:18px;height:18px;accent-color:var(--accent);flex:none}
  .paywall{text-align:center;padding:12px 0 4px}
  .paywall .lock{font-size:42px;margin-bottom:10px}
  .paywall h3{font-size:17px;margin-bottom:8px;overflow-wrap:anywhere}
  .paywall p{color:var(--muted);font-size:13px;line-height:1.6;margin-bottom:16px;overflow-wrap:anywhere}
  .price-big{font-size:30px;font-weight:800;letter-spacing:-1px;margin-bottom:16px;color:var(--accent)}
  .hint{font-size:11.5px;color:#5d688c;margin-top:12px;overflow-wrap:anywhere}
  .divider-text{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:11px;letter-spacing:.5px;text-transform:uppercase;font-weight:700;margin:18px 0}
  .divider-text::before,.divider-text::after{content:'';flex:1;height:1px;background:var(--line)}

  .player{
    aspect-ratio:16/9;border-radius:12px;position:relative;overflow:hidden;
    background:linear-gradient(135deg,#1b2a52,#0d1730 60%,#231a44);
    display:grid;place-items:center;border:1px solid var(--line);margin-bottom:14px;
  }
  .player .play{
    width:58px;height:58px;border-radius:50%;background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.28);display:grid;place-items:center;font-size:20px;
    cursor:pointer;transition:.18s;
  }
  .reader{
    background:#f6f6f2;border-radius:12px;padding:20px;color:#1a1a1a;margin-bottom:14px;
    min-height:180px;background-image:linear-gradient(#e7e7e0 1px,transparent 1px);
    background-size:100% 26px;background-position:0 34px;
  }
  .reader h4{font-size:15px;margin-bottom:16px;font-weight:700}
  .reader .l{height:9px;background:#dcdcd4;border-radius:4px;margin-bottom:11px}

  .progress-card{
    background:linear-gradient(135deg,rgba(91,140,255,.12),rgba(34,201,160,.08));
    border:1px solid rgba(91,140,255,.3);border-radius:var(--radius);padding:18px;margin-bottom:18px;
  }
  .progress-card h3{font-size:13px;color:#b9cdff;text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px;font-weight:700}
  .progress-bar{height:10px;background:rgba(0,0,0,.35);border-radius:99px;overflow:hidden;margin:10px 0 8px}
  .progress-bar .fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:99px;transition:width .4s}
  .progress-meta{font-size:12.5px;color:var(--muted)}
  .progress-meta strong{color:var(--text)}

  .premium-banner{
    border-radius:var(--radius);padding:18px;margin-bottom:18px;
    display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;
  }
  .premium-banner.gold-banner{
    background:linear-gradient(135deg,rgba(245,165,36,.12),rgba(232,133,60,.06));
    border:1px solid rgba(245,165,36,.35);
  }
  .premium-banner.member-banner{
    background:linear-gradient(135deg,rgba(139,91,255,.13),rgba(34,201,160,.06));
    border:1px solid rgba(139,91,255,.35);
  }
  .premium-banner h3{font-size:15px;font-weight:700;margin-bottom:6px}
  .premium-banner.gold-banner h3{color:var(--gold)}
  .premium-banner.member-banner h3{color:#b69cff}
  .premium-banner p{font-size:12.5px;color:var(--muted);line-height:1.5;max-width:460px}

  .ann{padding:12px 14px;border-radius:10px;background:#0e1830;border:1px solid var(--line);margin-bottom:10px}
  .ann h4{font-size:13.5px;font-weight:600;margin-bottom:4px;overflow-wrap:anywhere}
  .ann p{font-size:12.5px;color:var(--muted);line-height:1.55;margin-bottom:6px;overflow-wrap:anywhere}
  .ann .meta{font-size:11px}

  #toasts{position:fixed;bottom:22px;right:20px;left:20px;display:flex;flex-direction:column;align-items:flex-end;gap:8px;z-index:200;pointer-events:none}
  .toast{
    background:#16223c;border:1px solid var(--line);border-left:3px solid var(--accent);
    padding:11px 16px;border-radius:10px;font-size:13px;box-shadow:0 14px 34px rgba(0,0,0,.5);
    max-width:340px;pointer-events:auto;overflow-wrap:anywhere;animation:toast-in .25s ease;
  }
  .toast.ok{border-left-color:var(--accent2)}
  .toast.gold{border-left-color:var(--gold)}
  .toast.bad{border-left-color:var(--danger)}
  @keyframes toast-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}

  .empty{text-align:center;padding:44px 20px;color:var(--muted);font-size:13.5px}
  .empty .big{font-size:34px;margin-bottom:10px;opacity:.5}

  @media(max-width:860px){
    .shell{grid-template-columns:1fr}
    .sidebar{
      position:sticky;top:0;z-index:50;height:auto;
      flex-direction:row;flex-wrap:nowrap;align-items:center;gap:10px;
      padding:10px 14px;padding-top:calc(10px + env(safe-area-inset-top,0px));
      border-right:none;border-bottom:1px solid var(--line);
      background:#0a1120;
    }
    .sidebar .brand{margin:0;padding:0;flex:1;gap:10px}
    .sidebar .brand h1{font-size:15px}
    .sidebar .brand p{display:none}
    .sidebar .logo{width:32px;height:32px;font-size:14px;border-radius:9px}
    .sidebar .nav{display:none}
    .sidebar .spacer{display:none}
    .sidebar .userbox{border:none;padding:0;width:auto;display:flex;align-items:center;gap:8px}
    .sidebar .userbox .user-meta{display:none}
    .sidebar .userbox .role-pill{display:none}
    .sidebar .userbox .btn{width:auto;padding:7px 11px;font-size:11.5px;min-height:32px}

    .mobile-tabs{
      display:flex;position:fixed;left:0;right:0;bottom:0;z-index:60;
      background:#0c1425;border-top:1px solid var(--line);
      padding:4px 4px calc(4px + env(safe-area-inset-bottom,0px));
      box-shadow:0 -4px 24px rgba(0,0,0,.4);
    }
    .mobile-tab{
      flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;
      padding:7px 2px;color:var(--muted);font-size:9.5px;font-weight:600;
      border:none;background:none;border-radius:8px;transition:.15s;letter-spacing:.2px;
    }
    .mobile-tab .ic{font-size:17px;line-height:1;opacity:.9}
    .mobile-tab.active{color:var(--accent)}
    .mobile-tab:active{background:rgba(255,255,255,.04)}

    .main{padding:16px 14px calc(84px + env(safe-area-inset-bottom,0px))}
    .topbar{margin-bottom:16px}
    .topbar h2{font-size:19px}
    .topbar p{font-size:12.5px}

    .stats{grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:16px}
    .stat{padding:13px 14px}
    .stat .v{font-size:22px}
    .stat .k{font-size:10.5px}

    .grid{grid-template-columns:1fr;gap:12px}
    .card{padding:14px}
    .card:hover{transform:none;box-shadow:none}
    .btn.sm{padding:8px 13px;font-size:12.5px;min-height:36px}

    .console-grid{grid-template-columns:1fr}
    .form-row{grid-template-columns:1fr;gap:10px}
    .tbl-scroll table{min-width:560px}

    .overlay{padding:12px;padding-top:calc(12px + env(safe-area-inset-top,0px));padding-bottom:calc(12px + env(safe-area-inset-bottom,0px))}
    .modal{padding:18px 16px;border-radius:16px}

    .field input,.field select,.field textarea,
    .toolbar input[type=search],#cx-path,#cx-body,#cx-method{font-size:16px}

    .demo-creds .row{flex-wrap:wrap;gap:6px}
    .login-card{padding:22px}
    .login-wrap{padding:16px;padding-top:calc(16px + env(safe-area-inset-top,0px))}
    .premium-banner{padding:14px}
    .premium-banner .btn{width:100%}
  }
  @media(max-width:380px){
    .stats{grid-template-columns:1fr}
    .mobile-tab{font-size:9px}
    .mobile-tab .ic{font-size:16px}
  }
</style>
</head>
<body>
<div id="root"></div>
<div id="toasts"></div>

<script>
(function(){
'use strict';

/* ---------- helpers ---------- */
const $ = (s, r) => (r || document).querySelector(s);
const ls = {
  get: k => { try { return localStorage.getItem(k); } catch(e){ return null; } },
  set: (k,v) => { try { localStorage.setItem(k,v); } catch(e){} },
  del: k => { try { localStorage.removeItem(k); } catch(e){} }
};
const uid = p => p + '_' + Math.random().toString(36).slice(2,9);
const sleep = ms => new Promise(r => setTimeout(r, ms));
const rnd = (a,b) => Math.floor(a + Math.random()*(b-a));
