/* ---------- events ---------- */
document.addEventListener('click', async e => {
  const el = e.target.closest ? e.target.closest('[data-action]') : null;

  if (e.target.closest && e.target.closest('#login-btn')) { e.preventDefault(); await handleLogin(); return; }
  if (e.target.closest && e.target.closest('#signup-btn')) { e.preventDefault(); await handleSignup(); return; }

  if (!el) {
    const card = e.target.closest ? e.target.closest('[data-select-id]') : null;
    if (card && state.user && state.user.role === 'admin') {
      const id = card.getAttribute('data-select-id');
      if (state.selected.has(id)) state.selected.delete(id); else state.selected.add(id);
      render();
    }
    return;
  }
  const a = el.getAttribute('data-action');

  if (a === 'fill') {
    const e1 = document.getElementById('login-email');
    const p1 = document.getElementById('login-pw');
    if (e1) e1.value = el.getAttribute('data-e') || '';
    if (p1) p1.value = el.getAttribute('data-p') || '';
    return;
  }
  if (a === 'auth-mode') { state.authMode = el.getAttribute('data-mode') || 'login'; render(); return; }
  if (a === 'nav') { await go(el.getAttribute('data-view')); return; }
  if (a === 'logout') { await doLogout(); return; }
  if (a === 'filter') { state.filter.type = el.getAttribute('data-type'); render(); return; }
  if (a === 'close-modal') { state.modal = null; render(); return; }
  if (a === 'overlay') { if (e.target.closest('.modal')) return; state.modal = null; render(); return; }

  if (a === 'new-content') { state.modal = { type:'content-form', item:null }; render(); return; }
  if (a === 'edit-content') {
    const item = state.content.find(c => c.id === el.getAttribute('data-id'));
    if (item) { state.modal = { type:'content-form', item }; render(); }
    return;
  }
  if (a === 'delete-content') {
    const item = state.content.find(c => c.id === el.getAttribute('data-id'));
    if (item) { state.modal = { type:'confirm-delete', item }; render(); }
    return;
  }
  if (a === 'confirm-delete') {
    const id = el.getAttribute('data-id');
    const r = await api('DELETE','/content/' + id);
    state.modal = null;
    toast(r.status === 200 ? 'Deleted' : (r.data.error || 'Delete failed'), r.status === 200 ? 'ok' : 'bad');
    await loadData(state.view); render();
    return;
  }
  if (a === 'bulk') {
    const op = el.getAttribute('data-op');
    const ids = Array.from(state.selected);
    if (!ids.length) return;
    if (op === 'delete' && !confirm('Delete ' + ids.length + ' items?')) return;
    const r = await api('POST','/content/bulk', { ids, action: op });
    if (r.status === 200) toast('Bulk ' + op + ': ' + r.data.affected + ' affected', 'ok');
    else toast(r.data.error || 'Failed', 'bad');
    state.selected.clear();
    await loadData(state.view); render();
    return;
  }
  if (a === 'bulk-clear') { state.selected.clear(); render(); return; }

  if (a === 'open-content') {
    const id = el.getAttribute('data-id');
    const res = await api('GET','/content/' + id);
    if (res.status !== 200) { toast(res.data.error || 'Failed', 'bad'); return; }
    state.modal = { type:'viewer', item: res.data };
    await loadData(state.view); render();
    return;
  }
  if (a === 'buy') {
    const id = el.getAttribute('data-id');
    const r = await api('POST','/orders', { contentId: id });
    if (r.status >= 400) { toast(r.data.error || 'Purchase failed', 'bad'); return; }
    toast('Purchase complete', 'ok');
    const res = await api('GET','/content/' + id);
    if (res.status === 200) state.modal = { type:'viewer', item: res.data };
    await loadData(state.view); render();
    return;
  }
  if (a === 'toggle-progress') {
    const id = el.getAttribute('data-id');
    const r = await api('POST','/progress/' + id);
    if (r.status === 200) {
      toast(r.data.completed ? 'Marked complete' : 'Unmarked', 'ok');
      await loadData(state.view);
      const cres = await api('GET','/content/' + id);
      if (cres.status === 200) state.modal = { type:'viewer', item: cres.data };
      render();
    } else toast(r.data.error || 'Failed', 'bad');
    return;
  }
  if (a === 'fake-play') { toast('Streaming demo video'); return; }

  if (a === 'new-ann') { state.modal = { type:'announcement-form' }; render(); return; }
  if (a === 'del-ann') {
    const id = el.getAttribute('data-id');
    const r = await api('DELETE','/announcements/' + id);
    toast(r.status === 200 ? 'Removed' : (r.data.error || 'Failed'), r.status === 200 ? 'ok' : 'bad');
    await loadData(state.view); render();
    return;
  }

  if (a === 'del-whitelist') {
    const id = el.getAttribute('data-id');
    const r = await api('DELETE','/whitelist/' + id);
    toast(r.status === 200 ? 'Removed from whitelist' : (r.data.error || 'Failed'), r.status === 200 ? 'ok' : 'bad');
    await loadData('users'); render();
    return;
  }

  if (a === 'go-premium') { state.modal = { type:'confirm-premium' }; render(); return; }
  if (a === 'confirm-subscribe') {
    const r = await api('POST','/auth/subscribe');
    if (r.status === 200) {
      state.user = r.data;
      state.modal = null;
      toast('Welcome to Premium', 'gold');
      await loadData(state.view); render();
    } else toast(r.data.error || 'Upgrade failed', 'bad');
    return;
  }
  if (a === 'cancel-premium') {
    const r = await api('POST','/auth/cancel-premium');
    if (r.status === 200) {
      state.user = r.data;
      toast('Premium cancelled', 'ok');
      await loadData(state.view); render();
    } else toast(r.data.error || 'Failed', 'bad');
    return;
  }

  if (a === 'preset') {
    document.getElementById('cx-method').value = el.getAttribute('data-m');
    document.getElementById('cx-path').value = el.getAttribute('data-p');
    document.getElementById('cx-body').value = el.getAttribute('data-b') || '{}';
    return;
  }
  if (a === 'send-request') {
    const method = document.getElementById('cx-method').value;
    const path = document.getElementById('cx-path').value.trim();
    let body = {};
    const raw = document.getElementById('cx-body').value.trim();
    if (raw && raw !== '{}') {
      try { body = JSON.parse(raw); } catch(err) { toast('Invalid JSON body', 'bad'); return; }
    }
    state.lastResponse = await api(method, path, body);
    render();
    return;
  }

  if (a === 'reset-db') { resetDatabase(); return; }
  if (a === 'export-db') {
    try {
      const blob = new Blob([JSON.stringify(db, null, 2)], { type:'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url; link.download = 'studia-db.json';
      document.body.appendChild(link); link.click(); document.body.removeChild(link);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      toast('Exported', 'ok');
    } catch(err) { toast('Export failed', 'bad'); }
    return;
  }
});

document.addEventListener('change', async e => {
  const el = e.target.closest && e.target.closest('[data-action="change-role"]');
  if (!el) return;
  const id = el.getAttribute('data-id');
  const role = el.value;
