function filterItems(type, q){
  return state.content.filter(c => {
    if (type !== 'all' && c.type !== type) return false;
    if (q) {
      const hay = ((c.title||'') + ' ' + (c.subject||'') + ' ' + (c.description||'')).toLowerCase();
      if (hay.indexOf(q.toLowerCase()) === -1) return false;
    }
    return true;
  });
}

function resultsHTML(items){
  if (!items.length) return '<div class="empty"><div class="big">▤</div>Nothing matches this filter.</div>';
  return '<div class="grid">' + items.map(cardHTML).join('') + '</div>';
