/* progress */
function hGetProgress(p, b, ctx){ return db.progress[ctx.user.id] || {}; }

function hToggleProgress(params, body, ctx){
  const contentId = params[0];
  const item = db.content.find(c => c.id === contentId);
  if (!item) throw new HttpError(404, 'Content not found');
  if (!canAccess(ctx.user, item)) throw new HttpError(403, 'You need access to track progress on this item');
  if (!db.progress[ctx.user.id]) db.progress[ctx.user.id] = {};
  const cur = db.progress[ctx.user.id][contentId];
  if (cur) { delete db.progress[ctx.user.id][contentId]; saveDB(); return { completed:false }; }
  db.progress[ctx.user.id][contentId] = { completedAt: new Date().toISOString().slice(0,10) };
  saveDB();
  return { completed:true };
}

/* stats */
function hStats(){
  const paid = db.orders.filter(o => o.status === 'paid');
  const premiumCount = db.users.filter(u => u.role === 'premium').length;
  const byType = {};
  db.content.forEach(c => { byType[c.type] = (byType[c.type]||0) + 1; });
