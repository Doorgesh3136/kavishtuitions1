/* ---------- API ---------- */
function HttpError(status, message){ this.status = status; this.message = message; }
HttpError.prototype = Object.create(Error.prototype);

let AUTH_TOKEN = ls.get(TOKEN_KEY) || null;
const requestLog = [];
const safeUser = u => { const o = {}; for (const k in u) if (k !== 'password') o[k] = u[k]; return o; };

/* access helper */
function canAccess(user, content){
  if (user.role === 'admin') return true;
  if (content.free) return true;
  if (user.role === 'premium') return true;
  return db.orders.some(o => o.userId === user.id && o.contentId === content.id && o.status === 'paid');
}

/* auth */
function hSignup(p, body){
  const name = String(body.name || '').trim();
  const email = String(body.email || '').trim().toLowerCase();
  const password = String(body.password || '');
  if (!name) throw new HttpError(422, 'Please enter your name');
  if (!email || !email.includes('@')) throw new HttpError(422, 'Please enter a valid email');
  if (password.length < 6) throw new HttpError(422, 'Password must be at least 6 characters');
  if (db.users.some(u => u.email.toLowerCase() === email))
    throw new HttpError(409, 'An account with this email already exists');
  const wl = db.whitelist.find(w => String(w.email).toLowerCase() === email);
  const role = wl ? wl.role : 'student';
  const user = {
    id: 'u_' + uid('').slice(1),
    name, email, password, role,
    joined: new Date().toISOString().slice(0,10)
  };
  if (role === 'premium') user.premiumSince = user.joined;
  db.users.push(user);
  const token = 'tok_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36);
  db.sessions[token] = user.id;
  saveDB();
  return { token, user: safeUser(user), whitelisted: !!wl };
}

function hLogin(p, body){
  const email = String(body.email || '').trim().toLowerCase();
  const password = String(body.password || '');
  const user = db.users.find(u => String(u.email).toLowerCase() === email);
  if (!user) throw new HttpError(401, 'No account found with that email');
  if (user.password !== password) throw new HttpError(401, 'Incorrect password');
  const token = 'tok_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36);
  db.sessions[token] = user.id;
  saveDB();
  return { token, user: safeUser(user) };
}

function hLogout(){ if (AUTH_TOKEN) delete db.sessions[AUTH_TOKEN]; saveDB(); return { ok:true }; }
function hMe(p,b,ctx){ return safeUser(ctx.user); }

function hChangePassword(p, body, ctx){
  if (ctx.user.password !== body.oldPassword) throw new HttpError(400, 'Current password is incorrect');
  if (!body.newPassword || body.newPassword.length < 6) throw new HttpError(422, 'New password must be at least 6 characters');
  ctx.user.password = body.newPassword;
  saveDB();
  return { ok:true };
}

function hSubscribe(p, b, ctx){
  if (ctx.user.role === 'admin') throw new HttpError(400, 'Admins already have full access');
  if (ctx.user.role === 'premium') throw new HttpError(400, 'You are already on Premium');
  ctx.user.role = 'premium';
  ctx.user.premiumSince = new Date().toISOString().slice(0,10);
  saveDB();
  return safeUser(ctx.user);
}

function hCancelPremium(p, b, ctx){
  if (ctx.user.role !== 'premium') throw new HttpError(400, 'You are not on Premium');
  ctx.user.role = 'student';
  delete ctx.user.premiumSince;
  saveDB();
  return safeUser(ctx.user);
}

/* content */
function hListContent(p, b, ctx){
  const isAdmin = ctx.user.role === 'admin';
  const prog = db.progress[ctx.user.id] || {};
  return db.content.filter(c => isAdmin || c.published).map(c => {
    const item = Object.assign({}, c);
    item.locked = !canAccess(ctx.user, c);
    if (item.locked) delete item.url;
    item.completed = !!prog[c.id];
    return item;
  });
}

function hGetContent(params, b, ctx){
  const c = db.content.find(x => x.id === params[0]);
  if (!c) throw new HttpError(404, 'Content not found');
  const accessible = canAccess(ctx.user, c);
  c.views = (c.views || 0) + 1;
  saveDB();
  const out = Object.assign({}, c);
  out.locked = !accessible;
  if (out.locked) delete out.url;
  const prog = db.progress[ctx.user.id] || {};
  out.completed = !!prog[c.id];
  return out;
}

function hCreateContent(p, body){
  if (!body.title || !String(body.title).trim()) throw new HttpError(422, 'Title is required');
  const type = body.type || 'pdf';
  if (['pdf','video','notes','live'].indexOf(type) === -1) throw new HttpError(422, 'Invalid content type');
  const price = Number(body.price) || 0;
  if (price < 0) throw new HttpError(422, 'Price cannot be negative');
  const item = {
    id: 'c_' + uid('').slice(1),
    title: String(body.title).trim(), type,
    subject: body.subject || 'General',
    price, free: price === 0,
    published: body.published !== false,
    url: body.url || 'https://cdn.studia.mu/placeholder',
    description: body.description || '',
    createdAt: new Date().toISOString().slice(0,10),
    views: 0
  };
  db.content.unshift(item);
  saveDB();
  return item;
}

function hUpdateContent(params, body){
  const c = db.content.find(x => x.id === params[0]);
  if (!c) throw new HttpError(404, 'Content not found');
  ['title','type','subject','price','published','url','description'].forEach(k => { if (k in body) c[k] = body[k]; });
  c.price = Number(c.price) || 0;
  c.free = c.price === 0;
  saveDB();
  return c;
}

function hDeleteContent(params){
  const i = db.content.findIndex(x => x.id === params[0]);
  if (i === -1) throw new HttpError(404, 'Content not found');
  const [removed] = db.content.splice(i, 1);
  saveDB();
  return { deleted: removed.id };
}

function hBulkContent(p, body){
  const ids = Array.isArray(body.ids) ? body.ids : [];
  const action = body.action;
  if (['publish','unpublish','delete'].indexOf(action) === -1) throw new HttpError(422, 'Invalid action');
  let count = 0;
  if (action === 'delete') {
    db.content = db.content.filter(c => { if (ids.indexOf(c.id) !== -1) { count++; return false; } return true; });
  } else {
    db.content.forEach(c => { if (ids.indexOf(c.id) !== -1) { c.published = action === 'publish'; count++; } });
  }
  saveDB();
  return { action, affected: count };
}

/* orders */
function hListOrders(p, b, ctx){
  const isAdmin = ctx.user.role === 'admin';
  return db.orders
    .filter(o => isAdmin || o.userId === ctx.user.id)
    .map(o => {
      const u = db.users.find(x => x.id === o.userId);
      const c = db.content.find(x => x.id === o.contentId);
      return Object.assign({}, o, {
        userName: u ? u.name : 'Unknown user',
        contentTitle: c ? c.title : 'Deleted item'
      });
    })
    .sort((a,b) => b.date.localeCompare(a.date));
}

function hCreateOrder(p, body, ctx){
  const item = db.content.find(c => c.id === body.contentId);
  if (!item) throw new HttpError(404, 'Content not found');
  if (item.free) throw new HttpError(400, 'This item is free');
  if (ctx.user.role === 'premium') throw new HttpError(400, 'Your Premium membership already covers this');
  const ex = db.orders.find(o => o.userId === ctx.user.id && o.contentId === item.id && o.status === 'paid');
  if (ex) throw new HttpError(409, 'You already own this item');
  const order = {
    id: 'ORD-' + String(db.orders.length + 1).padStart(3, '0'),
    userId: ctx.user.id, contentId: item.id,
    amount: item.price, status: 'paid',
    date: new Date().toISOString().slice(0,10)
  };
  db.orders.push(order);
  saveDB();
  return order;
}

/* users & whitelist */
function hListUsers(){
  return db.users.map(u => {
    const out = safeUser(u);
    const orders = db.orders.filter(o => o.userId === u.id);
    out.purchases = orders.length;
    out.spent = orders.reduce((s,o) => s + o.amount, 0);
    return out;
  });
}

function hChangeRole(params, body, ctx){
  const target = db.users.find(u => u.id === params[0]);
  if (!target) throw new HttpError(404, 'User not found');
  if (target.id === ctx.user.id) throw new HttpError(400, "You can't change your own role");
  const role = body.role;
  if (['student','premium','admin'].indexOf(role) === -1) throw new HttpError(422, 'Invalid role');
  if (target.role === 'admin' && role !== 'admin') {
    const admins = db.users.filter(u => u.role === 'admin');
    if (admins.length <= 1) throw new HttpError(400, 'Cannot demote the last admin');
  }
  target.role = role;
  if (role === 'premium' && !target.premiumSince) target.premiumSince = new Date().toISOString().slice(0,10);
  if (role !== 'premium') delete target.premiumSince;
  saveDB();
  return safeUser(target);
}

function hListWhitelist(){ return db.whitelist.slice().sort((a,b) => b.addedAt.localeCompare(a.addedAt)); }

